generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BotStatus {
  PENDING_REVIEW
  ACTIVE
  BLOCKED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REFUNDED
  CANCELLED
  EXPIRED
}

// Camada admin de Controle de Aprovação de Vendas — separada de PaymentStatus,
// nunca usada como gatilho de pixels/saldo/automação (só controle/estatística).
enum SaleApprovalStatus {
  APPROVED
  PENDING
}

enum EventType {
  PAGE_VIEW
  VIEW_CONTENT
  LEAD
  INITIATE_CHECKOUT
  ADD_PAYMENT_INFO
  PURCHASE
  START
  MESSAGE_SENT
  BUTTON_CLICKED
  PAYMENT_PIX
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  password     String
  avatar       String?
  role         UserRole    @default(USER)
  isActive     Boolean     @default(true)
  // Default true pra não travar contas já existentes — só o registro novo
  // (auth.service.ts) grava false explicitamente e exige o código de verificação.
  emailVerified              Boolean   @default(true)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  emailVerificationAttempts  Int       @default(0)
  whatsapp       String?
  registrationIp String?
  // 2FA (TOTP) — obrigatório pra ADMIN, opcional pro resto. Secret cifrado com
  // encrypt()/decrypt() (src/common/utils/encryption.ts), mesmo padrão de
  // apiKey/apiSecret de adquirente. tokenVersion permite revogar sessões
  // (logout forçado) sem esperar o JWT de 7 dias expirar.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  tokenVersion     Int     @default(0)
  // Último timeStep TOTP aceito — impede reutilizar (replay) o mesmo código
  // dentro da janela de validade (otplib afterTimeStep).
  lastTotpTimeStep    Int?
  // Bloqueio de conta por tentativas de login falhas (independe do rate-limit
  // por IP, que sozinho não impede tentativas distribuídas por vários IPs).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ordem customizada de adquirentes PIX (ids, em ordem de fallback). Vazio = usa a
  // configuração global de prioridade/fallback (comportamento padrão de todo workspace).
  acquirerOrder String[] @default([])
  // Adquirentes desativados só pra este workspace (ids). Vazio = nenhum desativado,
  // comportamento padrão de todo workspace. Aplica-se em cima da ordem global OU customizada.
  disabledAcquirerIds String[] @default([])

  // Controle de Aprovação de Vendas — camada admin separada de status de pagamento.
  // Desativado por padrão: toda venda paga aprova 100% (comportamento idêntico ao atual).
  approvalControlEnabled Boolean @default(false)
  approvalPercentage     Int     @default(100)
  approvalApprovedCount  Int     @default(0)
  approvalTotalCount     Int     @default(0)

  bots        TelegramBot[]
  leads       Lead[]
  products    Product[]
  flows       Flow[]
  automations Automation[]
  segments    Segment[]
  redirectors Redirector[]
  domains     Domain[]
  facebookIntegration FacebookIntegration?
  facebookPixels      FacebookPixel[]
  kwaiIntegration     KwaiIntegration?
  kwaiAccounts        KwaiAccount[]
  kwaiEventLogs       KwaiEventLog[]
  utmifyIntegration   UtmifyIntegration?
  utmifyAccounts      UtmifyAccount[]
  blackpayConfig      BlackpayConfig?

  balance             WorkspaceBalance?
  balanceTransactions  BalanceTransaction[]
  balanceWithdrawals   BalanceWithdrawal[]

  webhookSettings     WebhookSettings?
  webhookLogs         WebhookLog[]

  pushSubscriptions        PushSubscription[]
  pushNotificationSettings PushNotificationSettings?
}

model TelegramBot {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botToken    String
  username    String
  webhookUrl  String?
  status      BotStatus @default(PENDING_REVIEW)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Pré-cache de mídia habilitado só pra bots criados a partir dessa feature.
  // false = comportamento de sempre (bots já existentes nunca são afetados).
  precacheEnabled Boolean @default(false)

  // chat_id capturado via /start cachewarmup (QR code) — usado pra aquecer o cache
  // de mídia proativamente, sem depender de lead real. Nulo até o dono escanear.
  warmupChatId String?

  flows       Flow[]
  leads       Lead[]
  facebookPixels FacebookPixel[]
  kwaiAccounts   KwaiAccount[]
  utmifyAccounts UtmifyAccount[]
}

model Acquirer {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  apiKey            String
  apiSecret         String?
  endpointCreatePix String?
  endpointCheckPix  String?
  webhookSecret     String?
  environment       String    @default("production")
  logoUrl           String?
  credentialStatus  String    @default("UNCONFIGURED")
  lastValidatedAt   DateTime?
  lastTestedAt      DateTime?
  priority          Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Lead {
  id           String   @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId        String?
  bot          TelegramBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  leadUid      String   @unique
  telegramId   String?
  name         String?
  username     String?
  phone        String?
  email        String?
  ip           String?
  userAgent    String?
  externalId   String?
  entryType    String?  // 'deep_link' | 'direct' | null
  startPayload String?  // payload do /start (ex: fluxo_123)
  tags         String[]
  score        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tracking     Tracking?
  events       Event[]
  payments     Payment[]
  segments     Segment[] @relation("LeadSegments")
}

model Tracking {
  id           String  @id @default(uuid())
  leadId       String  @unique
  lead         Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fbclid       String?
  gclid        String?
  ttclid       String?
  kwaiClickid  String?
  createdAt    DateTime @default(now())
}

model Product {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  currency    String            @default("BRL")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  payments    Payment[]
}

model Payment {
  id            String        @id @default(uuid())
  leadId        String
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactionId String        @unique
  gateway       String        @default("blackpay")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("BRL")
  status        PaymentStatus @default(PENDING)
  pixQrCode     String?
  pixCopyPaste  String?
  paidAt        DateTime?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Sistema de saldo — garante que o crédito nunca acontece duas vezes pro mesmo pagamento
  balanceCredited    Boolean             @default(false)
  balanceTransaction BalanceTransaction?

  // Controle de Aprovação de Vendas (painel admin) — nulo pra pagamentos que nunca
  // chegaram a APPROVED. Nunca usado como gatilho de pixels/UTMify/saldo (isso continua
  // 100% baseado em `status`); serve só pra estatística/exibição e aprovação manual.
  approvalStatus SaleApprovalStatus?
  approvedAt     DateTime?
  approvedBy     String?

  @@index([status, approvalStatus])
}

model Event {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventName String
  source    String?
  metadata  Json?
  createdAt DateTime  @default(now())
}

model Flow {
  id           String   @id @default(uuid())
  botId        String?
  bot          TelegramBot? @relation(fields: [botId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  nodes        Json
  edges        Json
  config       Json     @default("{}")
  trigger      String   @default("start")
  isActive     Boolean  @default(false)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  redirectors  Redirector[]
  versions     FlowVersion[]
}

model FlowVersion {
  id        String   @id @default(uuid())
  flowId    String
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version   Int
  nodes     Json
  edges     Json
  config    Json
  createdAt DateTime @default(now())
}

model Automation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  trigger     String
  conditions  Json?
  actions     Json
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Segment {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  conditions  Json
  leads       Lead[]   @relation("LeadSegments")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FacebookPixel {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId          String?
  bot            TelegramBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  name           String?
  pixelId        String
  accessToken    String
  isActive       Boolean      @default(true)
  eventPageView  Boolean      @default(true)
  eventAddToCart Boolean      @default(true)
  eventPurchase  Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId])
}

model FacebookIntegration {
  id             String   @id @default(uuid())
  workspaceId    String   @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pixelId        String
  accessToken    String
  isActive       Boolean  @default(false)
  eventPageView  Boolean  @default(true)
  eventAddToCart Boolean  @default(true)
  eventPurchase  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model KwaiIntegration {
  id             String   @id @default(uuid())
  workspaceId    String   @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pixelId        String
  accessToken    String
  testToken      String   @default("")
  isActive       Boolean  @default(false)
  eventAddToCart Boolean  @default(true)
  eventPurchase  Boolean  @default(true)
  eventContentView Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model KwaiAccount {
  id             String       @id @default(uuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId          String?
  bot            TelegramBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  name           String?
  pixelId        String
  accessToken    String
  testToken      String       @default("")
  isActive       Boolean      @default(true)
  eventAddToCart Boolean      @default(true)
  eventPurchase  Boolean      @default(true)
  eventContentView Boolean    @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId])
}

model KwaiEventLog {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventName    String
  pixelId      String
  clickId      String?
  chatId       String?
  orderId      String?
  value        Float?
  status       String   @default("pending")
  response     Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

model UtmifyIntegration {
  id              String   @id @default(uuid())
  workspaceId     String   @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey          String
  webhookUrl      String?
  isActive        Boolean  @default(false)
  eventPixGerado  Boolean  @default(true)
  eventPixPago    Boolean  @default(true)
  pixelId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UtmifyAccount {
  id             String       @id @default(uuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId          String?
  bot            TelegramBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  name           String?
  apiKey         String
  isActive       Boolean      @default(true)
  eventPixGerado Boolean      @default(true)
  eventPixPago   Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId])
}

model UtmifyEventLog {
  id           String   @id @default(uuid())
  workspaceId  String
  chatId       String?
  orderId      String?
  status       String
  valueInCents Int?
  response     Json?
  errorMessage String?
  sentAt       DateTime @default(now())
}

model BlackpayConfig {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey      String
  webhookSecret String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Domain {
  id          String       @id @default(uuid())
  domain      String       @unique
  isActive    Boolean      @default(false)
  isDefault   Boolean      @default(false)
  dnsStatus   String       @default("pending")  // 'pending' | 'active' | 'failed'
  sslStatus   String       @default("pending")  // 'pending' | 'active' | 'failed'
  verifiedAt  DateTime?
  sslIssuedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redirectors Redirector[]

  // Oculta da lista de escolha em NOVOS redirecionadores — não afeta links já
  // criados (a resolução de link não consulta esse campo) nem isActive/isDefault.
  hiddenFromPicker Boolean @default(false)

  // null = domínio global do admin (comportamento de sempre). Preenchido =
  // domínio próprio de uma conta, só utilizável pela mesma (máx. 3 por conta).
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Redirector {
  id                String            @id @default(uuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  slug              String            @unique
  // Código de 5 dígitos exigido nos parâmetros da URL (?app=) quando
  // rules.verificationCodeEnabled estiver ligado — camada extra além da
  // verificação por plataforma (fbclid/click_id).
  verificationCode  String
  flowId            String?
  flow              Flow?             @relation(fields: [flowId], references: [id], onDelete: SetNull)
  domainId          String?
  domain            Domain?           @relation(fields: [domainId], references: [id], onDelete: SetNull)
  alternativeUrl    String
  // Pra onde o tráfego que casou com as regras vai: 'telegram' (padrão, usa o
  // flowId acima) ou 'external' (usa externalUrl abaixo, sem depender de bot).
  destinationType   String            @default("telegram")
  externalUrl       String?
  rules             Json              @default("{}")
  isActive          Boolean           @default(true)
  totalClicks       Int               @default(0)
  telegramClicks    Int               @default(0)
  alternativeClicks Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  clicks            RedirectorClick[]
}

model RedirectorClick {
  id           String     @id @default(uuid())
  redirectorId String
  redirector   Redirector @relation(fields: [redirectorId], references: [id], onDelete: Cascade)
  destination  String
  source       String?
  device       String?
  os           String?
  country      String?
  language     String?
  ip           String?
  // Parâmetros da URL clicada (aba "Filtro" do admin) — salvos direto aqui
  // em vez de depender de UserTracking, que não tem FK pra Redirector (é
  // criada separadamente, no mesmo request, sem vínculo direto). Populados
  // em logClick() a partir do mesmo ctx que já alimentava saveTracking().
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fbclid       String?
  ttclid       String?
  kwaiId       String?
  // Informações complementares: de onde veio o clique (rede social
  // específica, WhatsApp, direto — classificado em classifyTrafficSource(),
  // ver redirectors.service.ts) e, quando destination='blocked', qual
  // Telegram ID causou o bloqueio desse IP (snapshot no momento do clique —
  // IpBlacklist.telegramId pode ser desvinculado/desbloqueado depois).
  referer            String?
  trafficSource      String?
  blockedTelegramId  String?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([redirectorId, createdAt])
}

model UserTracking {
  id            String    @id @default(uuid())
  platform      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  fbclid        String?
  fbp           String?
  fbc           String?
  ttclid        String?
  ttp           String?
  kwaiId        String?
  kwaiPixel     String?
  ip            String?
  userAgent     String?
  chatId        String?
  botStartedAt  DateTime?
  sourceUrl     String?
  capturedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([chatId, capturedAt(sort: Desc)])
}

model FacebookEventLog {
  id           String   @id @default(uuid())
  workspaceId  String
  chatId       String?
  eventName    String
  pixelId      String
  orderId      String?
  value        Decimal? @db.Decimal(10, 2)
  status       String
  response     Json?
  errorMessage String?
  sentAt       DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())
}

// Blacklist global de usuários do Telegram — chaveada pelo telegramId puro
// (from.id), independente de Lead.id, já que um mesmo usuário do Telegram
// gera um Lead diferente por bot/workspace (ver Lead.telegramId, sem
// @unique). Checada a cada mensagem/callback recebido, então telegramId
// precisa de índice único pra lookup O(1) — reforçado por cache em Redis
// (Set) no TelegramBlacklistService, então o Postgres não é consultado a
// cada interação, só na hidratação inicial do cache e nas escritas do admin.
model TelegramBlacklist {
  id         String   @id @default(uuid())
  telegramId String   @unique
  reason     String?
  createdBy  String?
  createdAt  DateTime @default(now())
}

// Camada complementar à blacklist por Telegram ID — só é checável no fluxo
// do Redirecionador (único ponto do sistema que vê o IP real do visitante;
// o Telegram nunca revela o IP do usuário pro bot, então bloqueio por IP
// não existe no webhook). Auto-vinculado: ao bloquear um telegramId,
// TelegramBlacklistService busca em UserTracking os IPs que aquele chatId
// já usou pra clicar em algum redirecionador, e bloqueia esses IPs também
// — sem exigir captura nova. Permanente (sem expiresAt, por decisão
// consciente do usuário — IP dinâmico/compartilhado é risco aceito).
// Sem cache em Redis: volume de cliques em redirecionador é bem menor que
// mensagens do Telegram, um lookup indexado direto no Postgres já basta.
model IpBlacklist {
  id         String   @id @default(uuid())
  ip         String   @unique
  telegramId String?
  reason     String?
  createdBy  String?
  createdAt  DateTime @default(now())
}

model RemarketingBroadcast {
  id          String    @id @default(uuid())
  flowId      String
  flowName    String
  botUsername String?
  workspaceId String?
  total       Int
  sent        Int       @default(0)
  failed      Int       @default(0)
  status      String    @default("RUNNING") // RUNNING | DONE
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
}

// ── Sistema de Saldo (Financeiro) ───────────────────────────────────────────

// Config global da taxa cobrada em cima de cada venda aprovada. Singleton — sempre
// lida/gravada pelo id fixo '00000000-0000-0000-0000-000000000001'.
model BalanceConfig {
  id            String   @id @default(uuid())
  feeType       String   @default("FIXED") // FIXED | PERCENTAGE
  feeValue      Decimal  @db.Decimal(10, 4) @default(0.30)
  // Taxa fixa cobrada toda vez que o usuário solicita um saque
  withdrawalFee Decimal  @db.Decimal(10, 2) @default(5.00)
  updatedAt     DateTime @updatedAt
}

// Singleton (sempre 1 linha, id fixo) — configurações globais da plataforma
model PlatformSettings {
  id                 String   @id @default(uuid())
  // Domínio usado para montar o link de redirecionamento pro Telegram: t.me | telegram.me
  telegramLinkDomain String   @default("t.me")
  // Nome de produto enviado às adquirentes PIX quando a cobrança não tem produto de
  // catálogo vinculado (botões de plano do fluxo, upsells) — cada adquirente tinha
  // seu próprio texto fixo ("Produto 1" etc); agora é editável no painel admin.
  pixDefaultProductName String @default("Produto 1")
  // Par de chaves VAPID (Web Push) — gerado automaticamente na primeira vez que
  // alguém precisa dele (ver PlatformSettingsService.getOrCreateVapidKeys), não
  // exige configuração manual. Chave privada sempre cifrada com encrypt()/decrypt(),
  // igual a todo outro segredo da plataforma.
  vapidPublicKey  String?
  vapidPrivateKey String?
  updatedAt          DateTime @updatedAt
}

model WorkspaceBalance {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  available      Decimal   @db.Decimal(10, 2) @default(0)
  totalReceived  Decimal   @db.Decimal(10, 2) @default(0)
  totalWithdrawn Decimal   @db.Decimal(10, 2) @default(0)
  updatedAt      DateTime  @updatedAt
}

model BalanceTransaction {
  id           String             @id @default(uuid())
  workspaceId  String
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         String             // SALE | WITHDRAWAL | ADJUSTMENT
  grossAmount  Decimal            @db.Decimal(10, 2)
  feeAmount    Decimal            @db.Decimal(10, 2) @default(0)
  netAmount    Decimal            @db.Decimal(10, 2)
  paymentId    String?            @unique
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  withdrawalId String?
  withdrawal   BalanceWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  status       String             @default("COMPLETED") // COMPLETED | PENDING | REJECTED
  createdAt    DateTime           @default(now())

  @@index([workspaceId, createdAt])
}

model BalanceWithdrawal {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amount       Decimal   @db.Decimal(10, 2) // valor solicitado, descontado do saldo disponível
  feeAmount    Decimal   @db.Decimal(10, 2) @default(0) // taxa de saque cobrada nesta solicitação
  netAmount    Decimal   @db.Decimal(10, 2) @default(0) // valor que efetivamente será pago via PIX (amount - feeAmount)
  pixKeyType   String
  pixKey       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?
  requestedAt  DateTime  @default(now())
  resolvedAt   DateTime?
  transactions BalanceTransaction[]

  @@index([status])
}

// Webhooks de SAÍDA (outbound) — 1 config por workspace. Não confundir com o módulo
// `webhooks` (entrada dos adquirentes PIX) nem com a fila `webhook-events` (nós de
// webhook dos fluxos de automação).
model WebhookSettings {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  url           String?
  secret        String?
  // Lista de eventos habilitados — escalável: novos eventos entram aqui sem migration.
  enabledEvents String[]  @default(["sale_pending", "sale_approved"])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WebhookLog {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentId      String?
  eventId        String    @unique // enviado no header X-Webhook-ID (idempotência p/ sistema externo)
  event          String            // sale_pending | sale_approved
  url            String
  payload        Json
  responseStatus Int?
  responseBody   String?           // truncado (primeiros ~2KB)
  executionMs    Int?
  attempts       Int       @default(0)
  success        Boolean   @default(false)
  errorMessage   String?
  isTest         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ── PWA / Web Push (notificações em tempo real) ─────────────────────────────

// Uma linha por dispositivo/navegador inscrito — N por workspace (diferente de
// WebhookSettings, que é 1:1). endpoint já identifica navegador+dispositivo de
// forma única, então serve de chave natural pra upsert no resubscribe.
model PushSubscription {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([workspaceId])
}

// Singleton por workspace — mesmo padrão do WebhookSettings. Sem linha salva =
// habilitado por padrão pros dois eventos (comportamento mais útil out-of-the-box).
model PushNotificationSettings {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(true)
  enabledEvents String[]  @default(["sale_pending", "sale_approved"])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
